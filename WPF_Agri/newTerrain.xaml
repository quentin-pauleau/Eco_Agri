<Page x:Class="WPF_Agri.newTerrain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Agri"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="newTerrain">

    <Grid Height="450" VerticalAlignment="Bottom">
        <Button x:Name="newTerrain_Back" Margin="744,0,0,0" Height="37" VerticalAlignment="Top" 
                Click="newTerrain_Back_Click" FontSize="15" FontWeight="SemiBold">Retour
        </Button>
        <Label Margin="0,0,0,400" Content="Nouveau Terrain" d:Background="Gray" FontSize="20" FontWeight="SemiBold" 
               VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Label Margin="101,0,598,300" Content="Nom" d:Background="Gray" FontSize="14" 
               VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label Margin="350,0,350,300" Content="Surface" d:Background="Gray" FontSize="14" 
               VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label Margin="598,0,101,300" Content="Surface" d:Background="Gray" FontSize="14" 
               VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBox x:Name="newTerrain_Name" Margin="53,95,550,317"/>
        <TextBox x:Name="newTerrain_Insee" Margin="302,95,302,317"/>
        <TextBox x:Name="newTerrain_Surface" Margin="550,95,53,317"/>

        <ListBox d:ItemsSource="{d:SampleData ItemCount=10}" Margin="131,208,472,62"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=10}" Margin="480,208,124,62"/>
        
        
        
        <Button x:Name="newTerrain_Confirm" Margin="365,403,365,0" Height="37" VerticalAlignment="Top" Content="Valider" FontSize="15" FontWeight="SemiBold" Click="newTerrain_Confirm_Click"/>
    </Grid>
</Page>
